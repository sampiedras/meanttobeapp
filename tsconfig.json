{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "config": ["config/*"],
      "app": ["src/App.tsx"]
    },
    "module": "esnext",
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "*.ts",
    "*.tsx"
  ]
}
